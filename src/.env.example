FLASK_ENV=development
FLASK_APP=app.py
SECRET_KEY=change-me

# PostgreSQL (example)
DATABASE_URL=postgresql://postgres:password@postgres:5432/smarthouse

# MongoDB
MONGODB_URI=mongodb://mongo:27017/smarthouse

# Redis
REDIS_URL=redis://redis:6379/0

# Frontend URL (for CORS/builds)
FRONTEND_URL=http://localhost:5173

# Optional credentials and settings
ADMIN_EMAIL=admin@example.com
LOG_LEVEL=INFO
